# Canonical site URL used for metadata, sitemap, JSON-LD. Set per environment.
NEXT_PUBLIC_SITE_URL=https://cosmo.vercel.app

# Optional. Overrides the published-CSV URL that `pnpm sync-journal-club` reads.
# Defaults to the group's sheet (see scripts/sync-journal-club.ts). Only needed
# if the journal-club spreadsheet is replaced.
# JOURNAL_CLUB_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/<ID>/export?format=csv

# Optional. Overrides the published-CSV URL that `pnpm sync-people` reads.
# Defaults to the group's roster sheet (see scripts/sync-people.ts).
# PEOPLE_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/<ID>/export?format=csv

# Optional. Overrides the plain-text export URL that `pnpm sync-research` reads.
# Defaults to the group's research document (see scripts/sync-research.ts).
# RESEARCH_DOC_TXT_URL=https://docs.google.com/document/d/<ID>/export?format=txt

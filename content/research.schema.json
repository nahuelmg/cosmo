{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "title": {
        "type": "object",
        "properties": {
          "es": {
            "type": "string",
            "minLength": 1
          },
          "en": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "es",
          "en"
        ],
        "additionalProperties": false
      },
      "short_description": {
        "type": "object",
        "properties": {
          "es": {
            "type": "string",
            "minLength": 1
          },
          "en": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "es",
          "en"
        ],
        "additionalProperties": false
      },
      "full_description": {
        "type": "object",
        "properties": {
          "es": {
            "type": "string",
            "minLength": 1
          },
          "en": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "es",
          "en"
        ],
        "additionalProperties": false
      },
      "icon": {
        "type": "string"
      },
      "image": {
        "type": "string"
      },
      "order": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "required": [
      "id",
      "title",
      "short_description",
      "full_description",
      "order"
    ],
    "additionalProperties": false
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "_meta": {
      "type": "object",
      "properties": {
        "synced_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "inspirehep",
              "arxiv"
            ]
          }
        },
        "counts": {
          "type": "object",
          "properties": {
            "inspirehep": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "arxiv": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "manual": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "inspirehep",
            "arxiv",
            "manual"
          ],
          "additionalProperties": false
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "synced_at",
        "sources",
        "counts",
        "warnings"
      ],
      "additionalProperties": false
    },
    "publications": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "authors": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "journal": {
            "type": "string",
            "minLength": 1
          },
          "year": {
            "type": "integer",
            "minimum": 1900,
            "maximum": 2100
          },
          "arxiv": {
            "type": "string",
            "pattern": "^(\\d{4}\\.\\d{4,5}|[a-z-]+\\/\\d{7})(v\\d+)?$"
          },
          "doi": {
            "type": "string",
            "pattern": "^10\\.\\d{4,9}\\/[-._;()/:A-Z0-9]+$"
          },
          "topic_tags": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source": {
            "default": "manual",
            "type": "string",
            "enum": [
              "manual",
              "inspirehep",
              "arxiv"
            ]
          },
          "abstract": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "authors",
          "title",
          "journal",
          "year",
          "topic_tags",
          "source"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "_meta",
    "publications"
  ],
  "additionalProperties": false
}

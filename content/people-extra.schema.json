{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "propertyNames": {
    "type": "string"
  },
  "additionalProperties": {
    "type": "object",
    "properties": {
      "role": {
        "type": "object",
        "properties": {
          "es": {
            "type": "string",
            "minLength": 1
          },
          "en": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "es",
          "en"
        ],
        "additionalProperties": false
      },
      "teaching_role": {
        "type": "object",
        "properties": {
          "es": {
            "type": "string",
            "minLength": 1
          },
          "en": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "es",
          "en"
        ],
        "additionalProperties": false
      },
      "affiliation": {
        "type": "object",
        "properties": {
          "es": {
            "type": "string",
            "minLength": 1
          },
          "en": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "es",
          "en"
        ],
        "additionalProperties": false
      },
      "inspirehep_id": {
        "type": "string",
        "pattern": "^[A-Z][A-Za-z-]*(\\.[A-Za-z-]+)+\\.\\d+$"
      },
      "orcid_id": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$"
      },
      "photo": {
        "type": "string"
      },
      "contact": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "orcid": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$"
          },
          "office": {
            "type": "string"
          },
          "scholar": {
            "type": "string",
            "format": "uri"
          }
        },
        "additionalProperties": false
      },
      "social_links": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "platform": {
              "type": "string",
              "enum": [
                "twitter",
                "linkedin",
                "github",
                "orcid",
                "scholar",
                "website",
                "bluesky",
                "instagram"
              ]
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "platform",
            "url"
          ],
          "additionalProperties": false
        }
      },
      "short_bio": {
        "type": "object",
        "properties": {
          "es": {
            "type": "string",
            "minLength": 1
          },
          "en": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "es",
          "en"
        ],
        "additionalProperties": false
      },
      "full_bio": {
        "type": "object",
        "properties": {
          "es": {
            "type": "string",
            "minLength": 1
          },
          "en": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "es",
          "en"
        ],
        "additionalProperties": false
      },
      "research_interests": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "es": {
              "type": "string",
              "minLength": 1
            },
            "en": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "es",
            "en"
          ],
          "additionalProperties": false
        }
      },
      "years": {
        "type": "object",
        "properties": {
          "start": {
            "type": "integer",
            "minimum": 1980,
            "maximum": 2100
          },
          "end": {
            "type": "integer",
            "minimum": 1980,
            "maximum": 2100
          }
        },
        "required": [
          "start"
        ],
        "additionalProperties": false
      },
      "thesis_topic": {
        "type": "object",
        "properties": {
          "es": {
            "type": "string",
            "minLength": 1
          },
          "en": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "es",
          "en"
        ],
        "additionalProperties": false
      },
      "current_position": {
        "type": "object",
        "properties": {
          "es": {
            "type": "string",
            "minLength": 1
          },
          "en": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "es",
          "en"
        ],
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  }
}
